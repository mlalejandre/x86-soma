    q16 v = a + (b - a) * f / 1000; return neg ? -v : v;
}
static q16 c181_cosq(int64_t deg1000) { return c181_sinq(deg1000 + 90000); }
static q16 c181_cbrt(q16 x)                         /* raiz cubica de x (Q16) -> Q16 */
{
    if (x <= 0) return 0;
    int64_t t = (int64_t)x << 32, lo = 0, hi = 1 << 20;
    while (lo < hi) { int64_t m = (lo + hi + 1) >> 1; if (m * m * m <= t) lo = m; else hi = m - 1; }
    return lo;
}
static int c181_to8(q16 lin)                         /* luz lineal Q16 -> sRGB 0..255 */
{
    if (lin <= 0) return 0;
    if (lin >= 65536) return 255;
    return c181_enc[(lin * 4096 + 32768) >> 16];
}
static uint32_t c181_pack(q16 r, q16 g, q16 b, int a) { return ((uint32_t)(a < 0 ? 0 : a > 255 ? 255 : a) << 24) | (uint32_t)c181_to8(r) << 16 | (uint32_t)c181_to8(g) << 8 | (uint32_t)c181_to8(b); }

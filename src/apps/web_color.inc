/* argumentos numericos de una funcion de color: "0.5 0.1 30deg / 50%" -> v[] en milesimas, pct[] */
static int c181_args(const char *p, int32_t v[4], int pct[4], int *none)
{
    int k = 0; *none = 0; memset(v, 0, 4 * sizeof(int32_t)); memset(pct, 0, 4 * sizeof(int)); v[3] = 1000;
    while (*p && *p != ')' && k < 4) {
        while (wu_isspace(*p) || *p == ',' || *p == '/') p++;
        if (*p == ')' || !*p) break;
        if (wu_startsi(p, "none")) { p += 4; k++; continue; }
        if (!parse_num(&p, &v[k])) return -1;
        if (*p == '%') { pct[k] = 1; p++; } else if (wu_startsi(p, "deg")) p += 3; else if (wu_startsi(p, "turn")) { v[k] *= 360; p += 4; } else if (wu_startsi(p, "grad")) { v[k] = v[k] * 9 / 10; p += 4; } else if (wu_startsi(p, "rad")) { v[k] = (int32_t)((int64_t)v[k] * 57296 / 1000); p += 3; }
        k++;
    }
    return k;
}
static int c181_alpha(const int32_t v[4], const int pct[4], int k) { return k >= 4 ? (pct[3] ? (int)(((int64_t)v[3] * 255 + 50000) / 100000) : (int)(((int64_t)v[3] * 255 + 500) / 1000)) : 255; }
static uint32_t c181_hwb(int32_t h, int32_t w, int32_t bk, int alpha)       /* w, bk: milesimas (0..1000) */
{
    if (w + bk >= 1000) { int g = (int)((int64_t)w * 255 / (w + bk ? w + bk : 1)); return ((uint32_t)alpha << 24) | (uint32_t)g << 16 | (uint32_t)g << 8 | (uint32_t)g; }
    uint32_t c = hsl_to_rgb(h, 1000, 500); int k = 1000 - w - bk, out[3];
    for (int i = 0; i < 3; i++) { int ch = (int)((c >> (16 - 8 * i)) & 255); out[i] = clamp255((ch * k + 255 * w + 500) / 1000); }
    return ((uint32_t)alpha << 24) | (uint32_t)out[0] << 16 | (uint32_t)out[1] << 8 | (uint32_t)out[2];
}
static uint32_t wc_parse_color_ex(const char *s, int *ok);
/* una expresion de color dentro de color-mix()/light-dark(): llega hasta la coma o el parentesis de cierre de nivel 0 */
static const char *c181_sub(const char *p, uint32_t *col, int *pctv, int *okk)
{
    while (wu_isspace(*p)) p++;
    const char *s = p; int dep = 0;
    while (*p && !(dep == 0 && (*p == ',' || *p == ')'))) { if (*p == '(') dep++; else if (*p == ')') dep--; p++; }
    const char *end = p;
    *pctv = -1; *okk = 0;
    char buf[128]; uint32_t bn = 0;
    const char *q = s;
    while (q < end) {                                       /* separa en componentes de nivel 0: un porcentaje y un color */
        while (q < end && wu_isspace(*q)) q++;
        const char *t = q; int d2 = 0;
        while (q < end && !(d2 == 0 && wu_isspace(*q))) { if (*q == '(') d2++; else if (*q == ')') d2--; q++; }
        uint32_t tl = (uint32_t)(q - t); if (!tl) break;
        if (t[tl - 1] == '%' && (wu_isdigit(t[0]) || t[0] == '.')) { const char *r = t; int32_t nv; if (parse_num(&r, &nv)) *pctv = nv / 100; }
        else { if (bn + tl + 1 < sizeof buf) { memcpy(buf + bn, t, tl); bn += tl; buf[bn++] = ' '; } }
    }
    buf[bn] = 0;
    *col = wc_parse_color_ex(buf, okk);
    return p;
}
static uint32_t c181_mix(const char *p, int *ok)       /* p: tras "color-mix(" */
{
    while (wu_isspace(*p)) p++;
    if (!wu_startsi(p, "in")) return 0;
    p += 2; while (wu_isspace(*p)) p++;
    int space = 0;                                        /* 0 srgb, 1 oklab/oklch/lab/lch, 2 srgb-linear */
    if (wu_startsi(p, "oklab") || wu_startsi(p, "oklch") || wu_startsi(p, "lab") || wu_startsi(p, "lch")) space = 1; else if (wu_startsi(p, "srgb-linear")) space = 2;
    while (*p && *p != ',') { if (*p == ')') return 0; p++; }
    if (*p != ',') return 0;
    p++;
    uint32_t c1 = 0, c2 = 0; int p1, p2, o1 = 0, o2 = 0;
    p = c181_sub(p, &c1, &p1, &o1); if (*p != ',') return 0;
    p++;
    p = c181_sub(p, &c2, &p2, &o2); if (!o1 || !o2) return 0;
    if (p1 < 0 && p2 < 0) { p1 = p2 = 500; } else if (p1 < 0) p1 = 1000 - p2; else if (p2 < 0) p2 = 1000 - p1;
    int sum = p1 + p2; if (sum <= 0) return 0;
    int mixa = 255; int a1 = (int)(c1 >> 24), a2 = (int)(c2 >> 24);
    int64_t w1 = p1, w2 = p2; if (sum < 1000) mixa = mixa * sum / 1000;
    int al = (int)(((int64_t)a1 * w1 + (int64_t)a2 * w2) / sum); al = al * mixa / 255;
    int64_t pw1 = (int64_t)a1 * w1, pw2 = (int64_t)a2 * w2, pt = pw1 + pw2; if (pt <= 0) { *ok = 1; return 0; }   /* mezcla premultiplicada */
    *ok = 1;
    if (space == 1) {
        q16 L1, A1, B1, L2, A2, B2; c181_to_oklab(c1, &L1, &A1, &B1); c181_to_oklab(c2, &L2, &A2, &B2);
        return c181_oklab((L1 * pw1 + L2 * pw2) / pt, (A1 * pw1 + A2 * pw2) / pt, (B1 * pw1 + B2 * pw2) / pt, al);
    }
    if (space == 2) {
        q16 r = (c181_dec[(c1 >> 16) & 255] * pw1 + c181_dec[(c2 >> 16) & 255] * pw2) / pt, g = (c181_dec[(c1 >> 8) & 255] * pw1 + c181_dec[(c2 >> 8) & 255] * pw2) / pt, b = (c181_dec[c1 & 255] * pw1 + c181_dec[c2 & 255] * pw2) / pt;

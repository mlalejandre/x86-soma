}
/* devuelve 1 y el color si s empieza por una de las funciones nuevas */
static int c181_func(const char *s, uint32_t *out)
{
    int32_t v[4]; int pct[4], none, k; const char *p = s; while (*p && *p != '(') p++;
    if (*p != '(') return 0;
    p++;
    if (wu_startsi(s, "color-mix(")) { int ok = 0; uint32_t c = c181_mix(p, &ok); if (ok) { *out = c; return 1; } return 0; }
    if (wu_startsi(s, "light-dark(")) { int pv, ok = 0; uint32_t c = 0; c181_sub(p, &c, &pv, &ok); if (ok) { *out = c; return 1; } return 0; }
    if ((k = c181_args(p, v, pct, &none)) < 3) {
        if (wu_startsi(s, "color(")) { /* color(srgb r g b) */ } else return 0;
    }
    if (wu_startsi(s, "hwb(")) { *out = c181_hwb(v[0] / 1000, pct[1] ? v[1] / 100 : v[1], pct[2] ? v[2] / 100 : v[2], c181_alpha(v, pct, k)); return 1; }
    if (wu_startsi(s, "oklch(") || wu_startsi(s, "oklab(")) {
        int lch = wu_lower(s[3]) == 'c' || wu_lower(s[4]) == 'c';
        q16 L = pct[0] ? (q16)v[0] * 65536 / 100000 : (q16)v[0] * 65536 / 1000;
        q16 a, b;
        if (lch) { q16 C = pct[1] ? (q16)v[1] * 65536 * 4 / 100000 / 10 : (q16)v[1] * 65536 / 1000; a = QM(C, c181_cosq(v[2])); b = QM(C, c181_sinq(v[2])); }
        else { a = pct[1] ? (q16)v[1] * 65536 * 4 / 100000 / 10 : (q16)v[1] * 65536 / 1000; b = pct[2] ? (q16)v[2] * 65536 * 4 / 100000 / 10 : (q16)v[2] * 65536 / 1000; }
        *out = c181_oklab(L, a, b, c181_alpha(v, pct, k)); return 1;
    }
    if (wu_startsi(s, "lab(") || wu_startsi(s, "lch(")) {
        int lch = wu_lower(s[1]) == 'c';
        q16 L = (q16)v[0] * 65536 / 1000, a, b;
        if (lch) { q16 C = (q16)v[1] * 65536 / 1000; a = QM(C, c181_cosq(v[2])); b = QM(C, c181_sinq(v[2])); }
        else { a = (q16)v[1] * 65536 / 1000; b = (q16)v[2] * 65536 / 1000; }

    }
    if (wu_startsi(s, "color(")) {       /* color(srgb|display-p3|... r g b [/ a]): se trata como sRGB */
        const char *q = p; while (wu_isspace(*q)) q++;
        while (*q && !wu_isspace(*q) && *q != ')') q++;
        if ((k = c181_args(q, v, pct, &none)) < 3) return 0;
        int c[3]; for (int i = 0; i < 3; i++) c[i] = clamp255(pct[i] ? (int)((int64_t)v[i] * 255 / 100000) : (int)(((int64_t)v[i] * 255 + 500) / 1000));
        *out = ((uint32_t)c181_alpha(v, pct, k) << 24) | (uint32_t)c[0] << 16 | (uint32_t)c[1] << 8 | (uint32_t)c[2]; return 1;
    }
    return 0;
}
